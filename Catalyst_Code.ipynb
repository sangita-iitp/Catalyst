      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import r2_score, mean_squared_error\n",
        "from sklearn.impute import SimpleImputer\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras import layers\n",
        "\n",
        "# -------------------------------\n",
        "# Step 1: Dataset\n",
        "# -------------------------------\n",
        "data = {\n",
        "    \"Catalyst_Name\": [\n",
        "        \"TiO2-P25\", \"GCN\", \"SBS\", \"11 GS\", \"13 GS\", \"31 GS\",\n",
        "        \"BiVO4/Sb2S3\", \"Sb2S3/ZnIn2S4\", \"Ag2WO4/Sb2S3\", \"Fe-doped g-C3N4/MoS2\",\n",
        "        \"MoS2/g-C3N4\", \"g-C3N4/Sb2S3 (this work)\", \"Co-MoS2/g-C3N4\",\n",
        "        \"0D/2D SnO2/g-C3N4\", \"ZnIn2S4/2% MoSe2\", \"CdS/MoS2@Ni2P\",\n",
        "        \"Synth_1\", \"Synth_2\", \"Synth_3\"\n",
        "    ],\n",
        "    \"Rate_Constant\": [0.0051, 0.0075, 0.0057, 0.0064, 0.0304, 0.0142,\n",
        "                      0.011, 0.009, 0.006, 0.012,\n",
        "                      0.010, 0.028, 0.013, 0.007, 0.020, 0.025,\n",
        "                      0.015, 0.018, 0.021],\n",
        "    \"Synergy_Factor\": [0, 0, 0, 0.48, 2.3, 1.07,\n",
        "                       1.0, 0.9, 0.6, 1.2,\n",
        "                       0.95, 2.1, 1.1, 0.7, 1.8, 2.0,\n",
        "                       1.5, 1.6, 1.9],\n",
        "    \"AQE\": [5, 6, 4, 7, 23, 10,\n",
        "            17, 18, 13, 19,\n",
        "            14, 23, 16.62, 4.5, 21.39, 24.4,\n",
        "            20.5, 21.0, 22.3],\n",
        "    \"Catalytic_Efficiency\": [58, 62, 56, 68, 99, 75,\n",
        "                             88.7, 85.36, 53.06, 81.4,\n",
        "                             74, 99, 86, 60, 91, 95,\n",
        "                             90, 92, 94]\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# -------------------------------\n",
        "# Step 2: Prepare model data\n",
        "# -------------------------------\n",
        "X = df[[\"Rate_Constant\", \"Synergy_Factor\", \"AQE\"]]\n",
        "y = df[\"Catalytic_Efficiency\"]\n",
        "\n",
        "# Handle missing values\n",
        "imputer = SimpleImputer(strategy=\"mean\")\n",
        "X_imputed = imputer.fit_transform(X)\n",
        "\n",
        "# Train base RF model\n",
        "rf = RandomForestRegressor(n_estimators=200, random_state=42)\n",
        "rf.fit(X_imputed, y)\n",
        "\n",
        "# -------------------------------\n",
        "# Step 3: GAN-based data generation\n",
        "# -------------------------------\n",
        "scaler = MinMaxScaler()\n",
        "X_scaled = scaler.fit_transform(X_imputed)\n",
        "latent_dim = 5\n",
        "\n",
        "def build_generator():\n",
        "    model = tf.keras.Sequential([\n",
        "        tf.keras.Input(shape=(latent_dim,)),\n",
        "        layers.Dense(8, activation='relu'),\n",
        "        layers.Dense(8, activation='relu'),\n",
        "        layers.Dense(3, activation='sigmoid')\n",
        "    ])\n",
        "    return model\n",
        "\n",
        "def build_discriminator():\n",
        "    model = tf.keras.Sequential([\n",
        "        tf.keras.Input(shape=(3,)),\n",
        "        layers.Dense(8, activation='relu'),\n",
        "        layers.Dense(4, activation='relu'),\n",
        "        layers.Dense(1, activation='sigmoid')\n",
        "    ])\n",
        "    return model\n",
        "\n",
        "gen = build_generator()\n",
        "disc = build_discriminator()\n",
        "disc.compile(optimizer='adam', loss='binary_crossentropy')\n",
        "\n",
        "disc.trainable = False\n",
        "z = layers.Input(shape=(latent_dim,))\n",
        "fake = gen(z)\n",
        "valid = disc(fake)\n",
        "gan = tf.keras.Model(z, valid)\n",
        "gan.compile(optimizer='adam', loss='binary_crossentropy')\n",
        "\n",
        "# Train GAN\n",
        "epochs = 300\n",
        "batch_size = 8\n",
        "real_data = X_scaled\n",
        "\n",
        "for epoch in range(epochs):\n",
        "    idx = np.random.randint(0, real_data.shape[0], batch_size)\n",
        "    real = real_data[idx]\n",
        "    noise = np.random.normal(0, 1, (batch_size, latent_dim))\n",
        "    fake = gen.predict(noise, verbose=0)\n",
        "\n",
        "    disc.trainable = True\n",
        "    disc.train_on_batch(real, np.ones((batch_size, 1)))\n",
        "    disc.train_on_batch(fake, np.zeros((batch_size, 1)))\n",
        "\n",
        "    disc.trainable = False\n",
        "    gan.train_on_batch(noise, np.ones((batch_size, 1)))\n",
        "\n",
        "# Generate synthetic data\n",
        "noise = np.random.normal(0, 1, (500, latent_dim))\n",
        "synthetic_scaled = gen.predict(noise)\n",
        "synthetic_data = scaler.inverse_transform(synthetic_scaled)\n",
        "synthetic_df = pd.DataFrame(synthetic_data, columns=[\"Rate_Constant\", \"Synergy_Factor\", \"AQE\"])\n",
        "synthetic_df[\"Catalytic_Efficiency\"] = rf.predict(synthetic_df)\n",
        "synthetic_df[\"Source\"] = \"Synthetic\"\n",
        "\n",
        "# -------------------------------\n",
        "# Step 4: Combine with real data\n",
        "# -------------------------------\n",
        "df_real = pd.DataFrame(X_imputed, columns=[\"Rate_Constant\", \"Synergy_Factor\", \"AQE\"])\n",
        "df_real[\"Catalytic_Efficiency\"] = y.values\n",
        "df_real[\"Source\"] = \"Real\"\n",
        "\n",
        "combined_df = pd.concat([df_real, synthetic_df], ignore_index=True)\n",
        "\n",
        "# -------------------------------\n",
        "# Step 5: Train new model\n",
        "# -------------------------------\n",
        "X_full = combined_df[[\"Rate_Constant\", \"Synergy_Factor\", \"AQE\"]]\n",
        "y_full = combined_df[\"Catalytic_Efficiency\"]\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(X_full, y_full, test_size=0.2, random_state=42)\n",
        "rf = RandomForestRegressor(n_estimators=200, random_state=42)\n",
        "rf.fit(X_train, y_train)\n",
        "\n",
        "# Evaluate\n",
        "y_pred = rf.predict(X_test)\n",
        "r2 = r2_score(y_test, y_pred)\n",
        "rmse = np.sqrt(mean_squared_error(y_test, y_pred))\n",
        "print(f\"Improved R^2 Score: {r2:.4f}\")\n",
        "print(f\"Improved RMSE: {rmse:.2f}\")\n",
        "\n",
        "# Predictions on original data\n",
        "y_real_pred = rf.predict(X_imputed)\n",
        "comparison_df = pd.DataFrame({\n",
        "    \"Catalyst_Name\": df[\"Catalyst_Name\"],\n",
        "    \"True_Efficiency\": y.values,\n",
        "    \"Predicted_Efficiency\": y_real_pred\n",
        "})\n",
        "print(\"\\nPredictions on original real dataset:\")\n",
        "print(comparison_df)\n",
        "\n",
        "# -------------------------------\n",
        "# Step 6: Save datasets\n",
        "# -------------------------------\n",
        "synthetic_df.to_csv(\"synthetic_dataset.csv\", index=False)\n",
        "combined_df.to_csv(\"combined_dataset.csv\", index=False)\n",
        "synthetic_df.to_excel(\"synthetic_dataset.xlsx\", index=False)\n",
        "combined_df.to_excel(\"combined_dataset.xlsx\", index=False)\n",
        "\n",
        "print(\"\\nDatasets saved successfully: synthetic_dataset & combined_dataset\")\n"
      ],
